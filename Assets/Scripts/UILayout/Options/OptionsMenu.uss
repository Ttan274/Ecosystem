/* BACKGROUND */
.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #121212;
}

/* ROOT */
.root {
    background-color: #1e1e1e;
    color: #dddddd;
    padding: 10px;
    flex-direction: column;
    height: 100%;
}

/* TAB BAR */
.tab-bar {
    flex-direction: row;
    background-color: #2b2b2b;
    padding: 6px;
}

.tab-bar Button {
    height: 36px;
    padding:4px;
    font-size: 12px;
    flex-grow: 1;
    margin: 4px;
    background-color: #3a3a3a;
    color: white;
    border-radius: 6px;
}

.tab-bar Button:hover {
    background-color: #505050;
}

/* CONTENT */
.content {
    padding: 12px;
    flex-grow: 1;
    overflow: hidden;
}

/* SCROLL */
.scroll {
    flex-grow: 1;
}

/* SECTION */
.section {
    background-color: #2a2a2a;
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
}

/* SECTION TITLE */
.section-title {
    font-size: 14px;
    unity-font-style: bold;
    margin-bottom: 4px;
}

/* ROW */
.row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

/* FIELDS */
IntegerField .unity-base-field__input {
    background-color: #1e1e1e;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    padding-top: 2px;
    padding-bottom: 2px;
}

IntegerField .unity-text-input {
    color: #ffffff;
    padding-left: 6px;

    height: 22px;
    line-height: 22px;

    padding-top: 0;
    padding-bottom: 0;
}

.row > IntegerField{
    flex-grow: 1;
}

Slider {
    height: 24px;
    -unity-user-select: none;
}

Slider > .unity-slider__track {
    height: 4px;
    margin-top: 10px;
}

Slider > .unity-slider__thumb {
    width: 12px;
    height: 12px;
    margin-top: 6px;
}

/* Sliders */
.slider-block {
    margin-bottom: 8px;
}

.field-label {
    font-size: 12px;
    color: #dddddd;
    margin-bottom: 4px;
}

.slider-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.slider-row > Slider {
    flex-grow: 1;
}

.slider-value {
    width: 40px;
    font-size: 11px;
    text-align: right;
    color: #ffffff;
}

/* Footer */
.footer {
    height: 56px;
    padding: 8px 16px;

    background-color: #1b1b1b;
    border-top-width: 1px;
    border-top-color: #333333;

    flex-direction: row;
    align-items: center;
}

.tooltip {
    position: absolute;
    bottom: 60px;        /* footer üstünde */
    right: 16px;

    max-width: 260px;
    padding: 6px 10px;

    background-color: #2a2a2a;
    color: #ffaaaa;

    font-size: 11px;
    border-radius: 4px;

    border-width: 1px;
    border-color: #444444;

    visibility: hidden;
    z-index: 100;
}

.footer Button {
    min-width: 160px;
}