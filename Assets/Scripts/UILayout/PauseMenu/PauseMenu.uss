.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.45);
    justify-content: center;
    align-items: center;
}

.pause-panel {
    width: 360px;
    padding: 20px;

    background-color: #2f6f97;
    border-radius: 8px;

    flex-direction: column;
    align-items: stretch;
}

.pause-title {
    font-size: 20px;
    color: white;
    unity-text-align: middle-center;
    margin-bottom: 16px;
}

.pause-panel Button {
    height: 44px;
    margin-bottom: 10px;

    font-size: 14px;
}
